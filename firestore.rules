rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins helper (if configured in admins collection)
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@nexisacademy[.]com$') && request.auth.token.email_verified == true)
      );
    }

    function isValidUser(data) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.role in ['student', 'parent', 'faculty', 'admin'] &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
        (!('isAnonymous' in data) || data.isAnonymous is bool) &&
        (!('studentClass' in data) || (data.studentClass is string && data.studentClass.size() <= 50));
    }

    function isValidDemoBooking(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 25 &&
        data.studentClass is string && data.studentClass.size() > 0 && data.studentClass.size() <= 50 &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('preferredTime' in data) || (data.preferredTime is string && data.preferredTime.size() <= 100)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Demo Bookings collection
    match /demoBookings/{bookingId} {
      allow create: if isValidDemoBooking(incoming());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Test connection doc
    match /test/connection {
      allow get: if true;
    }
  }
}
